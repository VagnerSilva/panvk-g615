#version 450

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, std430) buffer Output {
    uint data[];
} output_buffer;
layout(set = 0, binding = 1) uniform usampler2D input_image;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= 64u || y >= 32u)
        return;
    uint index = y * 64u + x;
    output_buffer.data[64u + 2048u + index] =
        texelFetch(input_image, ivec2(x, y), 0).r;
}
