diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index 758faab61eca8303ace9695a08cae1c622b278f6..70b0a92da891435a904f23d8b4dce2619b02bb82 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -75,13 +75,7 @@
    void panvk_v##_ver##_destroy_device(                                        \
       struct panvk_device *device, const VkAllocationCallbacks *pAllocator)
 
-PER_ARCH_FUNCS(6);
-PER_ARCH_FUNCS(7);
-PER_ARCH_FUNCS(10);
 PER_ARCH_FUNCS(11);
-PER_ARCH_FUNCS(12);
-PER_ARCH_FUNCS(13);
-PER_ARCH_FUNCS(14);
 
 static VkResult
 create_kmod_dev(struct panvk_physical_device *device,
@@ -1423,9 +1417,10 @@
       goto fail_kbase;
    }
 
-   if (!panvk_is_supported_kbase_model(device->model)) {
+   if (!kbase_kmod_is_csf(device->kmod.dev) ||
+       !panvk_is_supported_kbase_model(device->model)) {
       result = panvk_errorf(instance, VK_ERROR_INCOMPATIBLE_DRIVER,
-                            "Unsupported Kbase GPU product ID %#x",
+                            "This ICD requires Mali-G615 Kbase CSF (product ID %#x)",
                             device->model->gpu_prod_id);
       goto fail_kbase;
    }
diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index 1e6b69aaf1756830d0f85825225d8a4009de12f6..052eb9c0196f6085d18f1039c7919b2a986e7c27 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -2403,3 +2403,12 @@
    .query_timestamp        = kbase_kmod_query_timestamp,
    .bo_set_label           = kbase_kmod_bo_set_label,
 };
+
+bool
+kbase_kmod_is_csf(const struct pan_kmod_dev *dev)
+{
+   assert(dev->ops == &kbase_kmod_ops);
+   const struct kbase_kmod_dev *kbase_dev =
+      container_of(dev, const struct kbase_kmod_dev, base);
+   return kbase_dev->is_csf;
+}
