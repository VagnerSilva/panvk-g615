From: PanVK G615 Migration <panvk-migration@localhost>
Subject: [PATCH] panvk: build only v11 and reject non-CSF Kbase devices

Purpose: panvk: build only v11 and reject non-CSF Kbase devices
Source/Reference: Mesa 13baeb70c066a9f82d2bcfb29f06e4865212affa and the retired JM patch inventory.
Tested GPU: not run for this extracted series (target: Mali-G615).
Tested Kbase UAPI: not run for this extracted series (target: CSF 1.21).
Mesa base range: 27.0.0-devel (13baeb70c066a9f82d2bcfb29f06e4865212affa).
Dependencies: preceding G615 profile patches in scripts/apply-patches.sh.
Validation test: G615 host regressions, strict replay, Android and glibc builds.

diff --git a/src/panfrost/vulkan/meson.build b/src/panfrost/vulkan/meson.build
index 12661b10e508b830eeda9eaa0a2361cb18efd1bb..69ad3d64e007581ed41b4819e1e803b6682d56cb 100644
--- a/src/panfrost/vulkan/meson.build
+++ b/src/panfrost/vulkan/meson.build
@@ -72,21 +72,21 @@
 panvk_flags = []
 panvk_per_arch_libs = []
 
-bifrost_archs = [6, 7]
+bifrost_archs = []
 bifrost_inc_dir = ['bifrost']
 bifrost_files = [
   'bifrost/panvk_vX_meta_desc_copy.c',
 ]
 
-valhall_archs = [9, 10, 11]
+valhall_archs = [11]
 valhall_inc_dir = ['valhall']
 valhall_files = []
 
-fifthgen_archs = [12, 13, 14]
+fifthgen_archs = []
 fifthgen_inc_dir = ['fifthgen']
 fifthgen_files = []
 
-jm_archs = [6, 7]
+jm_archs = []
 jm_inc_dir = ['jm']
 jm_files = [
   'jm/panvk_vX_cmd_buffer.c',
@@ -99,7 +99,7 @@
   'jm/panvk_vX_gpu_queue.c',
 ]
 
-csf_archs = [10, 11, 12, 13, 14]
+csf_archs = [11]
 csf_inc_dir = ['csf']
 csf_files = [
   'csf/panvk_gpu_prerast.c',
@@ -143,7 +143,7 @@
   sha1_h,
 ]
 
-foreach arch : [6, 7, 10, 11, 12, 13, 14]
+foreach arch : [11]
   per_arch_files = common_per_arch_files
   inc_panvk_per_arch = []
 
