+   struct kbase_sync_file_waiter *waiter = ks->pending_data;
+   if (!waiter) {
+      mtx_unlock(&ks->mutex);
+      return vk_errorf(device, VK_ERROR_UNKNOWN,
+                       "kbase: missing sync_file payload");
+   }
+   if (waiter->fd < 0) {
+      int invalid_fd = waiter->fd;
+      mtx_unlock(&ks->mutex);
+      return vk_errorf(device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "kbase: invalid sync_file payload fd: %d",
+                       invalid_fd);
+   }
+
+   int fd = fcntl(waiter->fd, F_DUPFD_CLOEXEC, 0);
+   int error = fd < 0 ? errno : 0;
+   mtx_unlock(&ks->mutex);
+   if (fd < 0) {
+      VkResult result;
+      switch (error) {
+      case EMFILE:
+      case ENFILE:
+         result = VK_ERROR_TOO_MANY_OBJECTS;
+         break;
+      case EBADF:
+         result = VK_ERROR_INVALID_EXTERNAL_HANDLE;
+         break;
+      case ENOMEM:
+         result = VK_ERROR_OUT_OF_HOST_MEMORY;
+         break;
+      default:
+         result = VK_ERROR_UNKNOWN;
+         break;
+      }
+      return vk_errorf(device, result, "kbase: sync_file snapshot failed: %s",
+                       strerror(error));
+   }
+
+   *fd_out = fd;
+   return VK_SUCCESS;
+}
