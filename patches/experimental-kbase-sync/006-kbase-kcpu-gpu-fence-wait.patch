+struct kbase_kmod_csf_fence_import_queue {
+   struct pan_kmod_dev *dev;
+   simple_mtx_t lock;
+   base_kcpu_queue_id id;
+   uint64_t payload_addr, done_addr, last_target;
+   const volatile uint64_t *completed_seqno;
+   /* 255 tracked commands leave one slot for a done SET not yet retired. */
+   uint64_t targets[85];
+   unsigned head, count;
+   int fatal_error;
+};
+
+static void
+kbase_fence_import_error(const char *stage, int error, int *error_out)
+{
+   mesa_loge("kbase: fence import %s: %s", stage, strerror(error));
+   if (error_out)
+      *error_out = error;
+   errno = error;
+}
+
+static int
+kbase_fence_import_close(int owned_fd, int error)
+{
+   if (owned_fd >= 0 && close(owned_fd)) {
+      int close_error = errno;
+      mesa_loge("kbase: fence import close: %s", strerror(close_error));
+      if (!error)
+         error = close_error;
+   }
+   return error;
+}
+
+struct kbase_kmod_csf_fence_import_queue *
+kbase_kmod_csf_fence_import_queue_create(
+   struct pan_kmod_dev *dev, uint64_t payload_addr, uint64_t done_addr,
+   const volatile uint64_t *completed_seqno, int *error_out)
+{
+   if (!dev || dev->fd < 0 || !payload_addr || !done_addr ||
+       (payload_addr & 63) || (done_addr & 63) ||
+       payload_addr == done_addr || !completed_seqno ||
+       ((uintptr_t)completed_seqno & 7) || p_atomic_read(completed_seqno)) {
+      kbase_fence_import_error("invalid cells", EINVAL, error_out);
+      return NULL;
+   }
+
+   if (!kbase_kmod_is_csf(dev)) {
+      kbase_fence_import_error("requires CSF", ENOTSUP, error_out);
+      return NULL;
+   }
+
+   struct kbase_kmod_csf_fence_import_queue *queue =
+      calloc(1, sizeof(*queue));
+   if (!queue) {
+      kbase_fence_import_error("allocation", ENOMEM, error_out);
+      return NULL;
+   }
+
+   struct kbase_ioctl_kcpu_queue_new create = {0};
+   if (ioctl(dev->fd, KBASE_IOCTL_KCPU_QUEUE_CREATE, &create)) {
+      int error = errno;
+      free(queue);
+      kbase_fence_import_error("CREATE", error, error_out);
+      return NULL;
+   }
+
+   queue->dev = dev;
+   queue->id = create.id;
+   queue->payload_addr = payload_addr;
+   queue->done_addr = done_addr;
+   queue->completed_seqno = completed_seqno;
+   simple_mtx_init(&queue->lock, mtx_plain);
+   if (error_out)
+      *error_out = 0;
+   return queue;
+}
+
+enum kbase_kmod_csf_fence_import_result
+kbase_kmod_csf_fence_import(struct kbase_kmod_csf_fence_import_queue *queue,
+                          int owned_fd, uint64_t target, int *error_out)
+{
+   if (!queue) {
+      int error = kbase_fence_import_close(owned_fd, EINVAL);
+      kbase_fence_import_error("invalid queue", error, error_out);
+      return KBASE_CSF_FENCE_IMPORT_REJECTED;
+   }
+
+   simple_mtx_lock(&queue->lock);
+   enum kbase_kmod_csf_fence_import_result result =
+      KBASE_CSF_FENCE_IMPORT_REJECTED;
+   const char *stage = "validation";
+   int error = 0;
+   bool closed = false;
+
+   if (queue->fatal_error) {
+      error = queue->fatal_error;
+      result = KBASE_CSF_FENCE_IMPORT_FATAL;
+      goto out;
+   }
+
+   if (owned_fd < 0 || !target || target > UINT32_MAX ||
+       target <= queue->last_target) {
+      error = EINVAL;
+      goto out;
+   }
+
+   uint64_t completed = p_atomic_read(queue->completed_seqno);
+   while (queue->count && queue->targets[queue->head] <= completed) {
+      queue->head = (queue->head + 1) % 85;
+      queue->count--;
+   }
+   if (queue->count == 85) {
+      stage = "capacity exhausted";
+      error = EAGAIN;
+      goto out;
+   }
+
+   struct base_fence fence = {
+      .basep = { .fd = owned_fd, .stream_fd = -1 },
+   };
+   struct base_cqs_set_operation_info sets[2] = {
+      {
+         .addr = queue->payload_addr,
+         .val = target,
+         .operation = BASEP_CQS_SET_OPERATION_SET,
+         .data_type = BASEP_CQS_DATA_TYPE_U64,
+      },
+      {
+         .addr = queue->done_addr,
+         .val = target,
+         .operation = BASEP_CQS_SET_OPERATION_SET,
+         .data_type = BASEP_CQS_DATA_TYPE_U64,
+      },
+   };
+   struct base_kcpu_command commands[3] = {
+      {
+         .type = BASE_KCPU_COMMAND_TYPE_FENCE_WAIT,
+         .info.fence = { .fence = (uintptr_t)&fence },
+      },
+      {
+         .type = BASE_KCPU_COMMAND_TYPE_CQS_SET_OPERATION,
+         .info.cqs_set_operation = {
+            .objs = (uintptr_t)&sets[0], .nr_objs = 1,
+         },
+      },
+      {
+         .type = BASE_KCPU_COMMAND_TYPE_CQS_SET_OPERATION,
+         .info.cqs_set_operation = {
+            .objs = (uintptr_t)&sets[1], .nr_objs = 1,
+         },
+      },
+   };
+
+   unsigned accepted = 0;
+   for (unsigned i = 0; i < 3; i++) {
+      struct kbase_ioctl_kcpu_queue_enqueue enqueue = {
+         .addr = (uintptr_t)&commands[i],
+         .nr_commands = 1,
+         .id = queue->id,
+      };
+      stage = i == 0 ? "FENCE_WAIT" : i == 1 ? "SET payload" : "SET done";
+      if (ioctl(queue->dev->fd, KBASE_IOCTL_KCPU_QUEUE_ENQUEUE, &enqueue)) {
+         error = errno;
+      } else {
+         accepted++;
+         queue->last_target = target;
+      }
+      if (i == 0) {
+         error = kbase_fence_import_close(owned_fd, error);
+         closed = true;
+      }
+      if (error)
+         break;
+   }
+
+   if (error) {
+      if (accepted) {
+         queue->fatal_error = error;
+         result = KBASE_CSF_FENCE_IMPORT_FATAL;
+      }
+   } else {
+      queue->targets[(queue->head + queue->count) % 85] = target;
+      queue->count++;
+      result = KBASE_CSF_FENCE_IMPORT_OK;
+   }
+
+out:
+   if (!closed)
+      error = kbase_fence_import_close(owned_fd, error);
+   simple_mtx_unlock(&queue->lock);
+   if (error)
+      kbase_fence_import_error(stage, error, error_out);
+   else if (error_out)
+      *error_out = 0;
+   return result;
+}
+
+int
+kbase_kmod_csf_fence_import_queue_destroy(
+   struct kbase_kmod_csf_fence_import_queue *queue)
+{
+   if (!queue) {
+      kbase_fence_import_error("invalid destroy", EINVAL, NULL);
+      return -1;
+   }
+
+   simple_mtx_lock(&queue->lock);
+   struct kbase_ioctl_kcpu_queue_delete delete = { .id = queue->id };
+   if (ioctl(queue->dev->fd, KBASE_IOCTL_KCPU_QUEUE_DELETE, &delete)) {
+      int error = errno;
+      if (!queue->fatal_error)
+         queue->fatal_error = error;
+      simple_mtx_unlock(&queue->lock);
+      kbase_fence_import_error("DELETE", error, NULL);
+      return -1;
+   }
+   simple_mtx_unlock(&queue->lock);
+   simple_mtx_destroy(&queue->lock);
+   free(queue);
+   return 0;
+}
