Subject: [EXPERIMENTAL] panvk: Android release and cross-queue GPU waits on Kbase

Mesa base: 13baeb70c066a9f82d2bcfb29f06e4865212affa plus the G615 profile.
Requires Android 018 (historical 0178) for native-buffer import.
Includes the original Android release callback fix; replaces revision 1 of 002.
The GPU-wait update uses producer seqno addresses for cross-queue dependencies.

diff --git a/src/panfrost/vulkan/panvk_physical_device.h b/src/panfrost/vulkan/panvk_physical_device.h
--- a/src/panfrost/vulkan/panvk_physical_device.h
+++ b/src/panfrost/vulkan/panvk_physical_device.h
@@ -132,6 +132,11 @@ void panvk_kbase_sync_set_pending(
 bool panvk_kbase_sync_peek(struct vk_sync *sync, void **data,
                            uint64_t targets[PANVK_KBASE_SYNC_TARGET_COUNT]);
 
+bool panvk_kbase_sync_peek_addrs(
+   struct vk_sync *sync, void **data,
+   uint64_t targets[PANVK_KBASE_SYNC_TARGET_COUNT],
+   uint64_t target_addrs[PANVK_KBASE_SYNC_TARGET_COUNT]);
+
 int panvk_kbase_sync_gpu_wait_targets(
    struct vk_sync *sync, uint64_t out[PANVK_KBASE_SYNC_TARGET_COUNT]);
