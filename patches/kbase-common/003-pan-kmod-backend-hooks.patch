From 6495ddbd78402197e24c97a74c38b9759511ecdc Mon Sep 17 00:00:00 2001
From: PanVK Migration <panvk-migration@localhost>
Date: Wed, 4 Nov 2026 22:14:32 -0300
Subject: [PATCH] kmod: add Kbase backend hooks for Mesa 27

Adapt Kbase dispatch and mapping hooks to the Mesa 27 pan_kmod API.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>

Purpose: Add explicit Kbase backend selection and a backend-owned BO unmap
hook while retaining the Mesa 27 pan_kmod import/export and mmap callbacks.
Source/Reference: Current Kbase CSF backend overlay in this repository.
Tested GPU: none yet (compile validation pending).
Tested Kbase UAPI: n/a.
Mesa base range: 27.0.0-devel (pinned 13baeb70c066).
Dependencies: 001-meson-kmds-option.patch.
Validation test: Build the G615 CSF v11 Android ICD.
---
 src/panfrost/lib/kmod/pan_kmod.c | 34 ++++++++++++++++++++++++++++++++
 src/panfrost/lib/kmod/pan_kmod.h | 27 ++++++++++++++++++++++++-
 2 files changed, 60 insertions(+), 1 deletion(-)

diff --git a/src/panfrost/lib/kmod/pan_kmod.c b/src/panfrost/lib/kmod/pan_kmod.c
index 141bb49d..1b740fff 100644
--- a/src/panfrost/lib/kmod/pan_kmod.c
+++ b/src/panfrost/lib/kmod/pan_kmod.c
@@ -5,6 +5,7 @@
 
 #include <string.h>
 #include <xf86drm.h>
+#include <errno.h>
 
 #include "util/cache_ops.h"
 #include "util/u_memory.h"
@@ -14,6 +15,9 @@
 
 extern const struct pan_kmod_ops panfrost_kmod_ops;
 extern const struct pan_kmod_ops panthor_kmod_ops;
+#if defined(HAVE_PAN_KMOD_KBASE)
+extern const struct pan_kmod_ops kbase_kmod_ops;
+#endif
 #ifdef HAVE_PANFROST_VDRM
 extern const struct pan_kmod_ops panfrost_virtio_gpu_ops;
 extern const struct pan_kmod_ops panfrost_vpipe_ops;
@@ -31,6 +35,12 @@ static const struct backend {
       "panthor",
       &panthor_kmod_ops,
    },
+#if defined(HAVE_PAN_KMOD_KBASE)
+   {
+      "kbase",
+      &kbase_kmod_ops,
+   },
+#endif
 #ifdef HAVE_PANFROST_VDRM
    {
       "panfrost_virtio_gpu",
@@ -70,6 +80,30 @@ static const struct pan_kmod_allocator default_allocator = {
    .free = default_free,
 };
 
+struct pan_kmod_dev *
+pan_kmod_dev_create_with_driver(int fd, uint32_t flags,
+                                const char *driver_name,
+                                const struct pan_kmod_allocator *allocator)
+{
+   if (!allocator)
+      allocator = &default_allocator;
+
+   if (!driver_name || !driver_name[0]) {
+      mesa_loge("invalid kernel driver name");
+      errno = EINVAL;
+      return NULL;
+   }
+
+   for (unsigned i = 0; i < ARRAY_SIZE(backends); i++) {
+      if (!strcmp(backends[i].name, driver_name))
+         return backends[i].ops->dev_create(fd, flags, allocator);
+   }
+
+   mesa_loge("kernel driver '%s' is not supported by this build", driver_name);
+   errno = ENODEV;
+   return NULL;
+}
+
 struct pan_kmod_dev *
 pan_kmod_dev_create(int fd, uint32_t flags,
                     const struct pan_kmod_allocator *allocator)
diff --git a/src/panfrost/lib/kmod/pan_kmod.h b/src/panfrost/lib/kmod/pan_kmod.h
index 31ddc326..ebe611ea 100644
--- a/src/panfrost/lib/kmod/pan_kmod.h
+++ b/src/panfrost/lib/kmod/pan_kmod.h
@@ -44,6 +44,11 @@
 #include "pan_trace.h"
 #include "perf/mali_perf.h"
 
+/* Maximum number of /dev/mali* device nodes to probe. */
+#if defined(HAVE_PAN_KMOD_KBASE)
+#define PAN_KBASE_MAX_NODES 8
+#endif
+
 #if defined(__cplusplus)
 extern "C" {
 #endif
@@ -130,6 +135,9 @@ enum pan_kmod_bo_flags {
     * the KMD to force non-coherent mappings on IO coherent setup.
     */
    PAN_KMOD_BO_FLAG_IO_COHERENT = BITFIELD_BIT(7),
+
+   /* kbase CSF event memory monitored for cross-CSG synchronization. */
+   PAN_KMOD_BO_FLAG_CSF_EVENT = BITFIELD_BIT(8),
 };
 
 /* Allowed group priority flags. */
@@ -492,6 +500,9 @@ struct pan_kmod_ops {
    /* Map the buffer object to device memory. */
    void *(*bo_mmap)(struct pan_kmod_bo *bo, int prot, int flags, void *host_addr);
 
+   /* Unmap a CPU mapping when the backend owns the mapping lifetime. */
+   int (*bo_munmap)(struct pan_kmod_bo *bo, void *host_addr, size_t size);
+
    /* Flush the pending BO map syncs. */
    int (*flush_bo_map_syncs)(struct pan_kmod_dev *dev);
 
@@ -633,6 +644,11 @@ struct pan_kmod_dev *
 pan_kmod_dev_create(int fd, uint32_t flags,
                     const struct pan_kmod_allocator *allocator);
 
+struct pan_kmod_dev *
+pan_kmod_dev_create_with_driver(int fd, uint32_t flags,
+                                const char *driver_name,
+                                const struct pan_kmod_allocator *allocator);
+
 void pan_kmod_dev_destroy(struct pan_kmod_dev *dev);
 
 static inline struct pan_kmod_va_range
@@ -749,6 +765,15 @@ pan_kmod_bo_mmap(struct pan_kmod_bo *bo, int prot, int flags, void *host_addr)
    return host_addr;
 }
 
+static inline int
+pan_kmod_bo_munmap(struct pan_kmod_bo *bo, void *host_addr, size_t size)
+{
+   if (bo->dev->ops->bo_munmap)
+      return bo->dev->ops->bo_munmap(bo, host_addr, size);
+
+   return os_munmap(host_addr, size);
+}
+
 static inline bool
 pan_kmod_can_sync_bo_map_from_userland(struct pan_kmod_dev *dev)
 {
@@ -835,7 +860,7 @@ pan_kmod_get_dummy_object(struct pan_kmod_vm *vm)
    simple_mtx_lock(&vm->sparse_dummy.lock);
 
    if (!vm->sparse_dummy.bo) {
-      struct pan_kmod_bo *bo = pan_kmod_bo_alloc(vm->dev, vm, PAN_PGSIZE_2M,
+      struct pan_kmod_bo *bo = pan_kmod_bo_alloc(vm->dev, NULL, PAN_PGSIZE_2M,
                                                  PAN_KMOD_BO_FLAG_NO_MMAP);
       if (!bo)
          goto dummy_exit;
-- 
