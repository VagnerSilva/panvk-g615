From 078531d08bbdbab5f1a8dea1d1f46eb4821c2998 Mon Sep 17 00:00:00 2001
From: abhay-byte <zenithblue.dev@gmail.com>
Date: Fri, 23 Oct 2026 08:50:36 +0000
Subject: [PATCH 85/89] jm-v7 112: release the gs_bo_pool free list on pool
 reset and trim

Rationale: csf-v11 220 frees the command pool's BO free lists on
vkResetCommandPool(RELEASE_RESOURCES) and vkTrimCommandPool; the v6/v7
geometry emulation pool (gs_bo_pool, jm-v7 030) is added by this series,
so its free list is released here (perf review 2026-10-22 K6: "gs slabs
stay at their GPU-faulted committed size").
Expected gain: memory on v6/v7 after GS/tess/xfb-heavy command buffers:
the grown gs slabs (up to the faulted commit each) are freed on
reset-with-release or trim instead of staying committed until the pool
is destroyed.

Knob: PANVK_CMD_POOL_TRIM=0 (csf-v11 220) restores the old behaviour.
Arch: gs_pool is used by v6/v7 only. Not device-tested.

The auto-trim free-list set (csf-v11 226/231) only names the pools
that exist in the per-arch CSF series, so gs_bo_pool is added to it
here as well: 6 pools, gs at index 3, with the per-pool high-water
arrays sized to match.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_cmd_pool.c | 10 +++++++---
 src/panfrost/vulkan/panvk_cmd_pool.h |  2 +-
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_cmd_pool.c b/src/panfrost/vulkan/panvk_cmd_pool.c
index e37ddf62..475c2b94 100644
--- a/src/panfrost/vulkan/panvk_cmd_pool.c
+++ b/src/panfrost/vulkan/panvk_cmd_pool.c
@@ -99,6 +99,8 @@ panvk_cmd_pool_release_free_bos(struct panvk_cmd_pool *pool)
 {
    panvk_bo_pool_cleanup(&pool->cs_bo_pool);
    panvk_bo_pool_cleanup(&pool->desc_bo_pool);
+   /* jm-v7 112: the v6/v7 geometry emulation slabs (jm-v7 030). */
+   panvk_bo_pool_cleanup(&pool->gs_bo_pool);
    panvk_bo_pool_cleanup(&pool->varying_bo_pool);
    panvk_bo_pool_cleanup(&pool->tls_bo_pool);
    panvk_bo_pool_cleanup(&pool->tls_big_bo_pool);
@@ -129,7 +131,7 @@ panvk_cmd_pool_autotrim_enabled(struct panvk_device *dev)
    return v && pan_arch(pdev->kmod.dev->props.gpu_id) >= 10;
 }
 
-#define PANVK_CMD_POOL_BO_POOLS 5
+#define PANVK_CMD_POOL_BO_POOLS 6
 
 /* csf-v11 231: 226 kept only what the last reset gave back (+25%), so a pool
  * whose recordings vary in size freed BOs at a light reset and allocated
@@ -156,8 +158,10 @@ panvk_cmd_pool_bo_pools(struct panvk_cmd_pool *pool,
    out[0] = &pool->cs_bo_pool;
    out[1] = &pool->desc_bo_pool;
    out[2] = &pool->varying_bo_pool;
-   out[3] = &pool->tls_bo_pool;
-   out[4] = &pool->tls_big_bo_pool;
+   /* jm-v7 112: the v6/v7 geometry emulation slabs are trimmed too. */
+   out[3] = &pool->gs_bo_pool;
+   out[4] = &pool->tls_bo_pool;
+   out[5] = &pool->tls_big_bo_pool;
 }
 
 static void
diff --git a/src/panfrost/vulkan/panvk_cmd_pool.h b/src/panfrost/vulkan/panvk_cmd_pool.h
index 8794cb14..c0ab1186 100644
--- a/src/panfrost/vulkan/panvk_cmd_pool.h
+++ b/src/panfrost/vulkan/panvk_cmd_pool.h
@@ -24,7 +24,7 @@ struct panvk_cmd_pool {
     * each free list got back at one reset, in this window of resets and the
     * previous one. */
    struct {
-      uint32_t cur[5], prev[5];
+      uint32_t cur[6], prev[6];
       uint32_t resets;
    } autotrim;
 };
