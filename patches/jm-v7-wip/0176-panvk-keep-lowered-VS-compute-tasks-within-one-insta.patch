From 5d9fccd6f51e58e03098fe9bb33eb9167261c609 Mon Sep 17 00:00:00 2001
From: VagnerSilva <vagner23silva@gmail.com>
Date: Sat, 14 Nov 2026 01:37:02 -0300
Subject: [PATCH] panvk: keep lowered-VS compute tasks within one instance row

Rationale: PanProbe draw_params "divisor" failed on Mali-G615 MC2
(got_count=6 matched, but a_inst read 1004,1004,1004,1005,1005,1005
instead of 1004,1004,1005,1005,1006,1006). The test VS writes an SSBO,
so the draw goes through gpu_prerast: the VS runs as a compute dispatch
{vertex_count, instance_count, 1} with workgroup size 1, and the
instance-rate attribute is fetched by LD_ATTR with the instance ID
passed explicitly (global_invocation_id.y + chunk_instance).

gl_InstanceIndex, which comes from the same value, was right; only the
attribute was wrong, and it was wrong by task. With 2 shader cores,
calculate_task_axis_and_increment() splits the 6 workgroups into
DIV_ROUND_UP(6, 2) = 3 per task along Y, so each task spanned three
instances, and every invocation of the task got the element of the
task's first instance (0 >> 1 = 0 for instances 0-2, 3 >> 1 = 1 for
instances 3-5). Draws whose tasks never cross a Y row were unaffected:
base_vertex_instance ({4,3,1}) and draw_nonindexed ({3,2,1}) get one
row per task, and the MC6 (Poco X6 Pro) gets one workgroup per task for
this draw, which is why divisor passed there.

Add panvk_dispatch_info::single_row_tasks and set it for the lowered
VS dispatch (and its polygon pass, which shares the dispatch info).
cmd_dispatch_shader() then picks the task increment from the X extent
only, so the task axis stays X and no task spans two instances. The
indirect path already uses TASK_AXIS_X with an increment clamped to
the job's X size, so it needs no change.

Cost: draws with few vertices and many instances (point sprites,
instanced quads) get smaller tasks on the lowered-VS path. IDVS draws
and regular compute dispatches are unchanged.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 .panvk-patchlevel                               | 1 +
 src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c | 7 ++++++-
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c     | 1 +
 src/panfrost/vulkan/panvk_cmd_dispatch.h        | 7 +++++++
 4 files changed, 15 insertions(+), 1 deletion(-)
 create mode 100644 .panvk-patchlevel

diff --git a/.panvk-patchlevel b/.panvk-patchlevel
new file mode 100644
index 0000000..26d6d0d
--- /dev/null
+++ b/.panvk-patchlevel
@@ -0,0 +1 @@
+p0175
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c
index 0a912fb..82f5343 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_dispatch.c
@@ -326,8 +326,13 @@ panvk_per_arch(cmd_dispatch_shader)(
       } else {
          unsigned task_axis = MALI_TASK_AXIS_X;
          unsigned task_increment = 0;
+         /* A single-row task split only looks at X, so the increment never
+          * exceeds the row and the axis stays X.
+          */
+         const struct pan_compute_dim row_dim = {dim.x, 1, 1};
          panvk_per_arch(calculate_task_axis_and_increment)(
-            cs, phys_dev, &dim, &task_axis, &task_increment);
+            cs, phys_dev, info->single_row_tasks ? &row_dim : &dim,
+            &task_axis, &task_increment);
          cs_trace_run_compute(b, tracing_ctx, cs_scratch_reg_tuple(b, 0, 4),
                               task_increment, task_axis,
                               PANVK_COMPUTE_RES_SEL);
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index f6039b6..5374fac 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -4421,6 +4421,7 @@ gpu_prerast_vs(struct panvk_cmd_buffer *cmdbuf,
    struct panvk_dispatch_info dispatch = {
       .direct.wg_count = {vertex_count, instance_count, 1},
       .barrier = barrier,
+      .single_row_tasks = true,
    };
    if (source->indirect.buffer_dev_addr)
       dispatch.indirect.buffer_dev_addr = dispatch_params;
diff --git a/src/panfrost/vulkan/panvk_cmd_dispatch.h b/src/panfrost/vulkan/panvk_cmd_dispatch.h
index e0905e2..c14cac5 100644
--- a/src/panfrost/vulkan/panvk_cmd_dispatch.h
+++ b/src/panfrost/vulkan/panvk_cmd_dispatch.h
@@ -84,6 +84,13 @@ struct panvk_dispatch_info {
 
 #if PAN_ARCH >= 10
    enum panvk_csf_barrier barrier;
+
+   /* Keep each task within one Y row of workgroups. Set for lowered vertex
+    * shaders, where Y is the instance: LD_ATTR was observed to resolve
+    * instance-rate attributes once per task (G615 MC2), so a task spanning
+    * several instances reads the first instance's element for all of them.
+    */
+   bool single_row_tasks;
 #endif
 };
 
-- 
