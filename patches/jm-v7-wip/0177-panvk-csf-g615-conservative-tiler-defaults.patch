From: VagnerSilva <vagner23silva@gmail.com>
Subject: [PATCH] panvk/csf: conservative kbase tiler defaults on Mali-G615

Factorio in Pocket Foundry reportedly loses the GPU on G615 MC2 with
26.3.1. Disabling incremental rendering and using 10 initial / 400 maximum
heap chunks avoided the failure in a nearly five-minute run, which ended
normally. G615 MC6 reportedly performed similarly with either setting.
This is a workaround based on that report, not a long-duration validation.

Default all kbase G615 core counts and revisions to those settings, using
the model product ID rather than an Android marketing name. Keep explicit
PANVK_KBASE_TILER_IR and PANVK_KBASE_HEAP_CHUNKS overrides and the defaults
of other GPUs. Resolve the settings per physical device so group creation
and FINISH_FRAGMENT agree, and initial/spare/renewed heaps all use the
same sizes without a process-global cache of device-dependent values.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c  | 13 ++-----
 src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c | 57 ++++------------------------
 src/panfrost/vulkan/panvk_physical_device.c  | 38 +++++++++++++++++++
 src/panfrost/vulkan/panvk_physical_device.h  |  1 +
 4 files changed, 49 insertions(+), 60 deletions(-)
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index 5374fac..23cf04e 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -73,15 +73,6 @@ cmdbuf_skips_gpu_heap_ops(const struct panvk_cmd_buffer *cmdbuf)
    return phys_dev->kbase_node_path[0] != '\0';
 }
 
-/* kbase incremental rendering (jm-v7-wip 0161, panvk_vX_gpu_queue.c). */
-/* jm-v7-wip 0167: on by default only where verified (v11 X6 Pro, v13 S11
- * Ultra).  On v14 G1-Ultra the first submit hangs (subqueue 1 timeout,
- * DEVICE_LOST at vkCreateDevice); v10/v12 are untested.  PANVK_KBASE_TILER_IR
- * =1 forces it on, =0 off.  jm-v7-wip 0174: also on for v12 (SM-X926B
- * workload_perf: gs_layer -45 %, msaa -8 to -14 %, no failures). */
-DEBUG_GET_ONCE_BOOL_OPTION(kbase_tiler_ir, "PANVK_KBASE_TILER_IR",
-                           PAN_ARCH == 11 || PAN_ARCH == 12 || PAN_ARCH == 13)
-
 static bool
 render_needs_zs_crc_ext(struct panvk_cmd_buffer *cmdbuf)
 {
@@ -7376,6 +7367,8 @@ static VkResult
 issue_fragment_jobs(struct panvk_cmd_buffer *cmdbuf)
 {
    struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+   const struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(dev->vk.physical);
    const struct cs_tracing_ctx *tracing_ctx =
       &cmdbuf->state.cs[PANVK_SUBQUEUE_FRAGMENT].tracing;
    struct cs_builder *b = panvk_get_cs_builder(cmdbuf, PANVK_SUBQUEUE_FRAGMENT);
@@ -7570,7 +7563,7 @@ issue_fragment_jobs(struct panvk_cmd_buffer *cmdbuf)
        * with 8 max chunks).  PANVK_KBASE_TILER_IR=0: old behaviour. */
       const bool heap_stats = !cmdbuf_skips_gpu_heap_ops(cmdbuf);
 
-      if (!heap_stats && !debug_get_option_kbase_tiler_ir()) {
+      if (!heap_stats && !phys_dev->csf.kbase_tiler_ir) {
          /* Heap chunks are reclaimed by the queue's heap renewal. */
       } else if (td_count == 1) {
          cs_load_to(b, completed, cur_tiler, BITFIELD_MASK(4), 40);
diff --git a/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c
index a960824..a16f06d 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c
@@ -1108,21 +1108,6 @@ kbase_queue_wait_current(struct panvk_gpu_queue *queue,
    return VK_SUCCESS;
 }
 
-/* All subqueues in one kbase queue group (CS i = subqueue i, the panthor
- * layout), with the tiler OOM exception flag.  At max_chunks kbase then
- * answers a tiler OOM with a NULL chunk instead of terminating the group, and
- * the firmware runs the fragment CS's TILER_OOM handler (incremental
- * rendering, panvk_vX_exception_handler.c), which only reaches CSs of the
- * group that hit the OOM.  One group per subqueue (PANVK_KBASE_TILER_IR=0,
- * the old layout) turns every heap exhaustion into DEVICE_LOST. */
-/* jm-v7-wip 0167: on by default only where verified (v11 X6 Pro, v13 S11
- * Ultra).  On v14 G1-Ultra the first submit hangs (subqueue 1 timeout,
- * DEVICE_LOST at vkCreateDevice); v10/v12 are untested.  PANVK_KBASE_TILER_IR
- * =1 forces it on, =0 off.  jm-v7-wip 0174: also on for v12 (SM-X926B
- * workload_perf: gs_layer -45 %, msaa -8 to -14 %, no failures). */
-DEBUG_GET_ONCE_BOOL_OPTION(kbase_one_group, "PANVK_KBASE_TILER_IR",
-                           PAN_ARCH == 11 || PAN_ARCH == 12 || PAN_ARCH == 13)
-
 static void
 kbase_destroy_group(struct panvk_gpu_queue *queue)
 {
@@ -1155,6 +1140,8 @@ kbase_destroy_group(struct panvk_gpu_queue *queue)
    }
 }
 
+/* A single group lets the tiler OOM handler reach the fragment subqueue.
+ * With one group per subqueue (IR off), heap exhaustion is DEVICE_LOST. */
 static VkResult
 kbase_create_group(struct panvk_gpu_queue *queue)
 {
@@ -1166,7 +1153,9 @@ kbase_create_group(struct panvk_gpu_queue *queue)
    for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++)
       queue->subqueues[i].kbase.group_handle = UINT32_MAX;
 
-   const bool one_group = debug_get_option_kbase_one_group();
+   const struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(dev->vk.physical);
+   const bool one_group = phys_dev->csf.kbase_tiler_ir;
 
    for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
       struct panvk_subqueue *subq = &queue->subqueues[i];
@@ -2207,44 +2196,12 @@ kbase_heap_destroy_counted(struct pan_kmod_dev *kdev, uint64_t heap_ctx_va)
    p_atomic_dec(&panvk_mem_stats.heap_ctx_live);
 }
 
-/* csf-v11 224: kbase tiler heap sizes. Every renewal (about every submit in
- * big games, KBASE_TILER_HEAP_RENEW_WORK) creates a heap that commits and
- * zeroes its initial chunks, and up to PANVK_KBASE_HEAP_SLOTS heaps plus a
- * spare plus the TERM backlog are alive at once, so the initial size is
- * paid 5-20 times. The heap grows on demand (kbase tiler OOM), so fewer
- * initial chunks only cost a few more growth events per heap.
- * PANVK_KBASE_HEAP_CHUNKS=<initial>[,<max>]: default 4,<physical max>;
- * "10,400" is the old behaviour. */
 static void
 kbase_heap_chunks(const struct panvk_physical_device *phys_dev,
                   uint32_t *initial, uint32_t *max)
 {
-   static uint32_t init_v, max_v;
-
-   if (!p_atomic_read(&max_v)) {
-      uint32_t i = MIN2(phys_dev->csf.tiler.initial_chunks, 4);
-      uint32_t m = MAX2(phys_dev->csf.tiler.max_chunks, 200);
-      const char *e = os_get_option("PANVK_KBASE_HEAP_CHUNKS");
-
-      if (e && e[0]) {
-         char *end;
-         unsigned long v = strtoul(e, &end, 10);
-         if (v >= 1 && v <= 1024)
-            i = v;
-         if (*end == ',') {
-            v = strtoul(end + 1, NULL, 10);
-            if (v >= 8 && v <= 4096)
-               m = v;
-         }
-      }
-      i = MIN2(i, m);
-      p_atomic_set(&init_v, i);
-      p_atomic_set(&max_v, m);
-      mesa_logi("kbase: tiler heaps %u initial / %u max chunks of %u KiB",
-                i, m, phys_dev->csf.tiler.chunk_size / 1024);
-   }
-   *initial = p_atomic_read(&init_v);
-   *max = p_atomic_read(&max_v);
+   *initial = phys_dev->csf.tiler.initial_chunks;
+   *max = phys_dev->csf.tiler.max_chunks;
 }
 
 /* csf-v11 224: retired heaps queued for TERM on the heap thread still hold
diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index 06c661e..9a95f1d 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -1367,6 +1367,43 @@ fail:
 }
 
 #if defined(HAVE_PAN_KMOD_KBASE)
+static void
+kbase_init_tiler_options(struct panvk_physical_device *device, unsigned arch)
+{
+   /* G615 MC2 loses the GPU in Factorio with IR and small initial heaps.
+    * Use the same workaround on all G615 core counts and revisions. */
+   const bool g615 = device->model->gpu_prod_id == PAN_PROD_ID(11, 8, 3);
+   const bool ir_default =
+      !g615 && (arch == 11 || arch == 12 || arch == 13);
+   device->csf.kbase_tiler_ir =
+      debug_get_bool_option("PANVK_KBASE_TILER_IR", ir_default);
+
+   uint32_t initial =
+      g615 ? 10 : MIN2(device->csf.tiler.initial_chunks, 4);
+   uint32_t max = g615 ? 400 : MAX2(device->csf.tiler.max_chunks, 200);
+   const char *e = os_get_option("PANVK_KBASE_HEAP_CHUNKS");
+
+   if (e && e[0]) {
+      char *end;
+      unsigned long v = strtoul(e, &end, 10);
+      if (v >= 1 && v <= 1024)
+         initial = v;
+      if (*end == ',') {
+         v = strtoul(end + 1, NULL, 10);
+         if (v >= 8 && v <= 4096)
+            max = v;
+      }
+   }
+
+   device->csf.tiler.initial_chunks = MIN2(initial, max);
+   device->csf.tiler.max_chunks = max;
+   mesa_logi("kbase: tiler incremental rendering %s",
+             device->csf.kbase_tiler_ir ? "on" : "off");
+   mesa_logi("kbase: tiler heaps %u initial / %u max chunks of %u KiB",
+             device->csf.tiler.initial_chunks, max,
+             device->csf.tiler.chunk_size / 1024);
+}
+
 VkResult
 panvk_physical_device_init_kbase(struct panvk_physical_device *device,
                                  struct panvk_instance *instance,
@@ -1468,6 +1505,7 @@ panvk_physical_device_init_kbase(struct panvk_physical_device *device,
       device->csf.tiler.chunk_size = 1024 * 1024;
       device->csf.tiler.initial_chunks = 10;
       device->csf.tiler.max_chunks = 400;
+      kbase_init_tiler_options(device, arch);
    }
 
    if (arch != 10)
diff --git a/src/panfrost/vulkan/panvk_physical_device.h b/src/panfrost/vulkan/panvk_physical_device.h
index fd102fa..634ca72 100644
--- a/src/panfrost/vulkan/panvk_physical_device.h
+++ b/src/panfrost/vulkan/panvk_physical_device.h
@@ -36,6 +36,7 @@ struct panvk_physical_device {
 
    union {
       struct {
+         bool kbase_tiler_ir;
          struct {
             uint32_t chunk_size;
             uint32_t initial_chunks;
